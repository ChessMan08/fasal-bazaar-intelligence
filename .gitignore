# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Virtual environments
venv/
env/
.venv/

# OS junk
.DS_Store
Thumbs.db

# Editor/IDE
.vscode/
.idea/

# Streamlit runtime data -- keep the folder (via .gitkeep) but not generated
# pipeline outputs; these are meant to be regenerated by running the notebook,
# not committed. Delete these ignore lines if you'd rather ship a small sample
# dataset with the repo so judges see real numbers without running anything.
streamlit_app/data/*.csv
streamlit_app/data/*.parquet
!streamlit_app/data/.gitkeep

# Notebook execution outputs, if run from the repo root instead of Colab
/bench_cpu.csv
/bench_gpu.csv
/top_opportunities.csv
/risk_clusters.csv
/forecast.csv
/forecast_feature_importance.csv
/full_analyzed_data.parquet

# Packaging artifacts -- don't commit the distributable zip to its own repo
*.zip

# Never commit GCP service account keys or credentials
*-key.json
service-account*.json
.env
